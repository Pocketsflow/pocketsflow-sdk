{
  "name": "pocketsflow",
  "version": "3.0.0",
  "description": "Official Pocketsflow SDK for Node.js and TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pocketsflow",
    "payments",
    "digital-products",
    "subscriptions",
    "api",
    "sdk",
    "e-commerce",
    "webhooks"
  ],
  "author": "Pocketsflow <support@pocketsflow.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pocketsflow/pocketsflow-sdk"
  },
  "homepage": "https://pocketsflow.com",
  "bugs": {
    "url": "https://github.com/Pocketsflow/pocketsflow-sdk/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  }
}
